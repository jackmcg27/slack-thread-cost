{
  "name": "slack-thread-cost",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=packages/bot",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=packages/core",
    "prisma:migrate": "npm run prisma:migrate --workspace=packages/core",
    "prisma:seed": "npm run prisma:seed --workspace=packages/core",
    "prisma:studio": "npm run prisma:studio --workspace=packages/core"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
