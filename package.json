{
  "name": "slack-thread-cost",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "dotenv -e .env -- npm run dev --workspace=packages/bot",
    "dev:dashboard": "dotenv -e .env -- npm run dev --workspace=packages/dashboard",
    "start:bot": "dotenv -e .env -- npm run start --workspace=packages/bot",
    "start:dashboard": "dotenv -e .env -- npm run start --workspace=packages/dashboard",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "dotenv -e .env -- npm run prisma:generate --workspace=packages/core",
    "prisma:migrate": "dotenv -e .env -- npm run prisma:migrate --workspace=packages/core",
    "prisma:deploy": "dotenv -e .env -- npm run prisma:deploy --workspace=packages/core",
    "prisma:seed": "dotenv -e .env -- npm run prisma:seed --workspace=packages/core",
    "prisma:studio": "dotenv -e .env -- npm run prisma:studio --workspace=packages/core",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.5.4"
  }
}
