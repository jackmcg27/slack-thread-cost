# --- Slack app credentials (see README "Slack App Setup") ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Only needed if you later move off Socket Mode to an HTTP Events endpoint.
SLACK_SIGNING_SECRET=

# --- Database ---
# SQLite for dev. For prod, point at postgresql://... and switch the
# `provider` in packages/core/prisma/schema.prisma to "postgresql".
DATABASE_URL=file:./dev.db

# --- Staff classification lookup ---
# "manual" (default, CSV-backed) or "denodo" (stub, not yet functional)
CLASSIFICATION_PROVIDER=manual
CLASSIFICATION_MAPPING_FILE=./packages/core/src/classification/data/classification-mapping.csv
# Optional: classification code applied when a Slack user isn't found in
# the mapping. Leave blank to leave them "unclassified" (flagged in the UI).
DEFAULT_CLASSIFICATION_CODE=

# --- Denodo provider config (only used when CLASSIFICATION_PROVIDER=denodo) ---
DENODO_BASE_URL=
DENODO_AUTH_TYPE=basic
DENODO_USERNAME=
DENODO_PASSWORD=
DENODO_TOKEN=
DENODO_VIEW_NAME=
DENODO_LOOKUP_COLUMN=email
DENODO_CLASSIFICATION_COLUMN=
DENODO_TIMEOUT_MS=5000

# --- Ingestion scope ---
# Comma-separated Slack channel IDs. Leave blank to track every channel
# the bot has been invited to.
TRACKED_CHANNELS=

# --- Dashboard ---
# Port is fixed at 3311 (packages/dashboard/package.json) — nothing to
# configure here.
